root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Trailing whitespace is significant in Markdown (line breaks)
trim_trailing_whitespace = false

[*.{json,jsonc}]
indent_size = 2

[*.{yaml,yml}]
indent_size = 2

[*.jsonl]
# Generated standards data — leave it exactly as written
insert_final_newline = true
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
